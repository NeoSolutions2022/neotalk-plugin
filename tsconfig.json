{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "extension/dist",
    "rootDir": "extension/src",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"]
  },
  "include": ["extension/src/**/*.ts"]
}
