{
  "name": "neotalk-chrome-extension",
  "version": "1.4.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:offscreen",
    "build:offscreen": "esbuild extension/src/offscreen/offscreen.ts --bundle --outfile=extension/dist/offscreen/offscreen.js --format=esm --platform=browser",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"extension/src/**/*.ts\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.28.1",
    "eslint": "^9.7.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "allowScripts": {
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true,
    "esbuild@0.28.1": true
  }
}
